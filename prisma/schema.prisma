// Transport API — Prisma Schema
// Database: Neon PostgreSQL + PostGIS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Networks ─────────────────────────────────────────────────────────────────

model Network {
  id               Int     @id @default(autoincrement())
  networkCode      String  @unique @map("network_code") @db.VarChar(50)
  name             String  @db.VarChar(255)
  operator         String? @db.VarChar(255)
  transportType    String? @map("transport_type") @db.VarChar(100)
  corridorLengthKm Float?  @map("corridor_length_km")
  totalStations    Int?    @map("total_stations")

  stations    Station[]
  routes      Route[]
  zones       Zone[]
  fares       Fare[]
  connections Connection[]

  @@map("networks")
}

// ─── Stations ─────────────────────────────────────────────────────────────────

model Station {
  id          Int     @id @default(autoincrement())
  stationCode String  @unique @map("station_code") @db.VarChar(255)
  stationName String  @map("station_name") @db.VarChar(255)
  latitude    Float?
  longitude   Float?
  networkId   Int     @map("network_id")
  district    String? @db.VarChar(255)
  geom        Unsupported("geometry(Point, 4326)")?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  network         Network         @relation(fields: [networkId], references: [id], onDelete: Cascade)
  routeStations   RouteStation[]
  travelTimesFrom TravelTime[]    @relation("from_station")
  travelTimesTo   TravelTime[]    @relation("to_station")
  edgesFrom       TransportEdge[] @relation("edge_from")
  edgesTo         TransportEdge[] @relation("edge_to")
  transfersFrom   TransferEdge[]  @relation("transfer_from")
  transfersTo     TransferEdge[]  @relation("transfer_to")
  zoneStations    ZoneStation[]
  connections     Connection[]

  @@map("stations")
}

// ─── Routes ───────────────────────────────────────────────────────────────────

model Route {
  id                  Int     @id @default(autoincrement())
  routeCode           String  @unique @map("route_code") @db.VarChar(255)
  routeName           String  @map("route_name") @db.VarChar(255)
  networkId           Int     @map("network_id")
  routeType           String? @map("route_type") @db.VarChar(100)
  description         String?
  originTerminal      String? @map("origin_terminal") @db.VarChar(255)
  destinationTerminal String? @map("destination_terminal") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  network        Network          @relation(fields: [networkId], references: [id], onDelete: Cascade)
  routeStations  RouteStation[]
  travelTimes    TravelTime[]
  transportEdges TransportEdge[]
  operatingHours OperatingHours[]

  @@map("routes")
}

// ─── Route Stations ───────────────────────────────────────────────────────────

model RouteStation {
  id           Int @id @default(autoincrement())
  routeId      Int @map("route_id")
  stationId    Int @map("station_id")
  stationOrder Int @map("station_order")

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([routeId, stationId])
  @@unique([routeId, stationOrder])
  @@map("route_stations")
}

// ─── Travel Times ─────────────────────────────────────────────────────────────

model TravelTime {
  id                Int   @id @default(autoincrement())
  routeId           Int   @map("route_id")
  fromStationId     Int   @map("from_station_id")
  toStationId       Int   @map("to_station_id")
  travelTimeMinutes Float @map("travel_time_minutes")

  route       Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromStation Station @relation("from_station", fields: [fromStationId], references: [id], onDelete: Cascade)
  toStation   Station @relation("to_station", fields: [toStationId], references: [id], onDelete: Cascade)

  @@unique([routeId, fromStationId, toStationId])
  @@map("travel_times")
}

// ─── Transport Edges (for routing graph) ──────────────────────────────────────

model TransportEdge {
  id                Int   @id @default(autoincrement())
  fromStationId     Int   @map("from_station_id")
  toStationId       Int   @map("to_station_id")
  routeId           Int   @map("route_id")
  travelTimeMinutes Float @default(0) @map("travel_time_minutes")

  fromStation Station @relation("edge_from", fields: [fromStationId], references: [id], onDelete: Cascade)
  toStation   Station @relation("edge_to", fields: [toStationId], references: [id], onDelete: Cascade)
  route       Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("transport_edges")
}

// ─── Transfer Edges (walking between networks) ────────────────────────────────

model TransferEdge {
  id                 Int   @id @default(autoincrement())
  fromStationId      Int   @map("from_station_id")
  toStationId        Int   @map("to_station_id")
  distanceMeters     Float @map("distance_meters")
  walkingTimeMinutes Float @map("walking_time_minutes")

  fromStation Station @relation("transfer_from", fields: [fromStationId], references: [id], onDelete: Cascade)
  toStation   Station @relation("transfer_to", fields: [toStationId], references: [id], onDelete: Cascade)

  @@map("transfer_edges")
}

// ─── Zones ────────────────────────────────────────────────────────────────────

model Zone {
  id        Int    @id @default(autoincrement())
  zoneCode  String @map("zone_code") @db.VarChar(100)
  zoneName  String @map("zone_name") @db.VarChar(255)
  networkId Int    @map("network_id")

  network      Network       @relation(fields: [networkId], references: [id], onDelete: Cascade)
  zoneStations ZoneStation[]

  @@unique([zoneCode, networkId])
  @@map("zones")
}

model ZoneStation {
  id        Int @id @default(autoincrement())
  zoneId    Int @map("zone_id")
  stationId Int @map("station_id")

  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([zoneId, stationId])
  @@map("zone_stations")
}

// ─── Fares ────────────────────────────────────────────────────────────────────

model Fare {
  id             Int    @id @default(autoincrement())
  networkId      Int    @map("network_id")
  zonesTravelled String @map("zones_travelled") @db.VarChar(50)
  priceFcfa      Int    @map("price_fcfa")

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@map("fares")
}

// ─── Operating Hours ──────────────────────────────────────────────────────────

model OperatingHours {
  id                      Int      @id @default(autoincrement())
  routeId                 Int      @map("route_id")
  dayType                 String   @map("day_type") @db.VarChar(100)
  days                    String[]
  firstDeparture          String?  @map("first_departure") @db.VarChar(10)
  lastDeparture           String?  @map("last_departure") @db.VarChar(10)
  peakTimeRange           String?  @map("peak_time_range") @db.VarChar(50)
  peakFrequencyMinutes    Int?     @map("peak_frequency_minutes")
  offpeakTimeRange        String?  @map("offpeak_time_range") @db.VarChar(50)
  offpeakFrequencyMinutes Int?     @map("offpeak_frequency_minutes")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("operating_hours")
}

// ─── Intermodal Connections ───────────────────────────────────────────────────

model Connection {
  id             Int      @id @default(autoincrement())
  stationId      Int      @map("station_id")
  networkId      Int      @map("network_id")
  connectedModes String[] @map("connected_modes")

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([stationId, networkId])
  @@map("connections")
}
